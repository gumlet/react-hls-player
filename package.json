{
  "name": "@gumlet/react-hls-player",
  "version": "3.0.0",
  "description": "React component for HLS and DASH playback using Shaka Player, with Gumlet Widevine and FairPlay",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src example --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "start": "webpack serve --config webpack/webpack.dev.js",
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumlet/react-hls-player.git"
  },
  "keywords": [
    "hls",
    "dash",
    "shaka",
    "shaka-player",
    "drm",
    "widevine",
    "fairplay",
    "react",
    "video",
    "live",
    "vod",
    "component"
  ],
  "author": "Gumlet",
  "license": "MIT",
  "bugs": {
    "url": "https://www.gumlet.com/contact/"
  },
  "homepage": "https://github.com/gumlet/react-hls-player",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@gumlet/insights-js-core": "^4.2.1",
    "shaka-player": "5.1.x"
  }
}
