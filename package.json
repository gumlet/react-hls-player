{
  "name": "@gumlet/react-hls-player",
  "version": "3.0.0",
  "description": "React component for HLS and DASH playback using Shaka Player, with Gumlet Widevine and FairPlay",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "biome lint src example vite.config.mts vitest.config.mts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "start": "vite",
    "build:example": "vite build",
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumlet/react-hls-player.git"
  },
  "keywords": [
    "hls",
    "dash",
    "shaka",
    "shaka-player",
    "drm",
    "widevine",
    "fairplay",
    "react",
    "video",
    "live",
    "vod",
    "component"
  ],
  "author": "Gumlet",
  "license": "MIT",
  "bugs": {
    "url": "https://www.gumlet.com/contact/"
  },
  "homepage": "https://github.com/gumlet/react-hls-player",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@gumlet/insights-js-core": "^4.2.1",
    "shaka-player": "5.1.x"
  }
}
